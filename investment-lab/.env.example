# ─── Auth (Auth.js / NextAuth) ───────────────────────────────────────────────
# Required for non-demo (live) mode. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Login username (default: admin)
AUTH_USER=admin

# Login password. If unset, DEMO_MODE is forced on and demo/demo works.
AUTH_PASSWORD=

# ─── Demo mode ───────────────────────────────────────────────────────────────
# true | false. Auto-true when AUTH_PASSWORD is unset OR DEMO_MODE=true.
# Demo never writes into live research/portfolio tables mixed with live runs.
DEMO_MODE=

# ─── Database (libsql / Turso) ───────────────────────────────────────────────
# Local default: file:./data/investment-lab.db (created automatically)
# Remote Turso / libsql example: libsql://your-db.turso.io
LIBSQL_URL=
# Alias accepted by the client (same as LIBSQL_URL if set)
DATABASE_URL=
# Turso auth token when using remote libsql
LIBSQL_AUTH_TOKEN=

# ─── Market / AI providers ───────────────────────────────────────────────────
# Optional. Without OPENAI_API_KEY the demo AI synthesizer is used.
OPENAI_API_KEY=
# OpenAI-compatible base URL (default https://api.openai.com/v1)
OPENAI_BASE_URL=
# Model id (default gpt-4o-mini)
OPENAI_MODEL=

# ─── App defaults ────────────────────────────────────────────────────────────
# IANA timezone for schedule + idempotency keys (default Europe/London)
APP_TIMEZONE=Europe/London
# Weekday research local time HH:mm (default 22:30)
RESEARCH_SCHEDULE_LOCAL=22:30
# Base reporting currency (default GBP)
BASE_CURRENCY=GBP
# Starting paper balance for new portfolios (default 500)
STARTING_PAPER_BALANCE=500

# Budget / cost soft limits (USD per calendar month)
MONTHLY_AI_BUDGET_USD=10
# Max position as fraction of portfolio (default 0.25 = 25%)
MAX_POSITION_WEIGHT=0.25
# Max sector weight (default 0.40)
MAX_SECTOR_WEIGHT=0.40
# Allow fractional shares in paper fills (default true)
ALLOW_FRACTIONAL_SHARES=true
# Catch up one missed weekday research run on next trigger (default true)
CATCH_UP_MISSED_RUNS=true

# ─── Cron protection ─────────────────────────────────────────────────────────
# Bearer token required for GET /api/cron/research
CRON_SECRET=

# ─── Next.js / Auth.js URL (set in production) ───────────────────────────────
# e.g. https://your-app.vercel.app/investment-lab
# NEXTAUTH_URL / AUTH_URL used by Auth.js
AUTH_URL=
NEXTAUTH_URL=
